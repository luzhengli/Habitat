{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Habitat",
  "version": "0.1.0",
  "identifier": "com.habitat.skills",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Habitat",
        "width": 1440,
        "height": 1024,
        "minWidth": 860,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Local Codex skill links, made explicit."
  }
}
